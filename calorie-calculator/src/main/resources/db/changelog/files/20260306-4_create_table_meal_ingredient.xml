<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
				   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

	<changeSet author="lucas" id="20260306-4-1">
		<createTable tableName="meal_ingredient">
			<column name="id_meal" type="bigint">
				<constraints nullable="false"></constraints>
			</column>
			<column name="id_ingredient" type="bigint">
				<constraints nullable="false"></constraints>
			</column>
			<column name="quantity" type="double precision">
				<constraints nullable="false"></constraints>
			</column>
		</createTable>
	</changeSet>

	<changeSet author="lucas" id="20260306-4-2" >
		<addForeignKeyConstraint baseTableName="meal_ingredient" baseColumnNames="id_meal"
								 referencedTableName="meal" referencedColumnNames="id"
								 constraintName="fk_meal_ingredient_meal"/>
	</changeSet>

	<changeSet author="lucas" id="20260306-4-3" >
		<addForeignKeyConstraint baseTableName="meal_ingredient" baseColumnNames="id_ingredient"
								 referencedTableName="ingredient" referencedColumnNames="id"
								 constraintName="fk_meal_ingredient_ingredient"/>
	</changeSet>
	<changeSet author="lucas" id="20260306-4-4">
		<addPrimaryKey tableName="meal_ingredient" columnNames="id_meal, id_ingredient" constraintName="pk_meal_ingredient"/>
	</changeSet>

</databaseChangeLog>
