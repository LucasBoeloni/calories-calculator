<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
				   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

	<changeSet author="lucas" id="20260306-2-1">
		<createTable tableName="user">
			<column name="id" type="bigint">
				<constraints nullable="false"></constraints>
			</column>
			<column name="name" type="varchar(200)">
				<constraints nullable="false"></constraints>
			</column>
		</createTable>
	</changeSet>

	<changeSet author="lucas" id="20260306-2-2">
		<createSequence sequenceName="sequence_user"
						dataType="bigint"
						startValue="1"
						incrementBy="1"></createSequence>
	</changeSet>

	<changeSet author="lucas" id="20260306-2-3" >
		<addPrimaryKey tableName="user" columnNames="id" constraintName="pk_user"/>
	</changeSet>

</databaseChangeLog>
